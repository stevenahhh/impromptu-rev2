# Copy to .env for compose.production.yaml. Replace every change-me value before deployment.
# Database passwords must use only URL-safe characters: A-Z, a-z, 0-9, underscore, and hyphen.

# [REQUIRED, secret] Shared private-backend/projection-gateway bearer token; use at least 32 random characters.
SERVICE_AUTH_TOKEN=change-me-random-service-token-32-chars
# [REQUIRED, secret] Bootstrap controller password.
CONTROLLER_PASSWORD=change-me-random-controller-password
# [REQUIRED] Bootstrap controller login name.
CONTROLLER_USERNAME=presenter
# [REQUIRED] Stable bootstrap controller account identifier.
CONTROLLER_ACCOUNT_ID=account_production

# [REQUIRED, secret] PostgreSQL bootstrap superuser password used only by startup migrations.
POSTGRES_BOOTSTRAP_PASSWORD=change-me-bootstrap-db-password
# [REQUIRED, secret] PostgreSQL migration role password.
MIGRATION_DATABASE_PASSWORD=change-me-migration-db-password
# [REQUIRED, secret] PostgreSQL private_app role password.
PRIVATE_DATABASE_PASSWORD=change-me-private-db-password
# [REQUIRED, secret] PostgreSQL projection_app role password.
PROJECTION_DATABASE_PASSWORD=change-me-projection-db-password
# [REQUIRED, secret] PostgreSQL publication_dispatcher role password.
PUBLICATION_DISPATCHER_DATABASE_PASSWORD=change-me-dispatcher-db-password
# [REQUIRED, secret] PostgreSQL retention_worker role password.
RETENTION_DATABASE_PASSWORD=change-me-retention-db-password

# [REQUIRED] Exact HTTPS browser-visible Console origin accepted by CORS and CSRF checks.
CONSOLE_PUBLIC_ORIGIN=https://console.example.com
# [REQUIRED] Exact HTTPS browser-visible Stage origin accepted by CORS and realtime checks.
STAGE_PUBLIC_ORIGIN=https://stage.example.com
# [REQUIRED] Exact HTTPS private API origin reached by the Console server-side proxy.
CONSOLE_PRIVATE_API_ORIGIN=https://private-api.example.com
# [OPTIONAL, build-time] Leave unset. The Stage bundle addresses the origin it is served from and
# its Nginx proxies /v1 to the projection gateway, so the audience session cookie is never
# cross-site on any browser. Setting this pins the bundle and its CSP to a second origin instead,
# which only works while that origin stays on the same registrable domain as STAGE_PUBLIC_ORIGIN.
# STAGE_PUBLIC_API_ORIGIN=https://projection.example.com
# [OPTIONAL] Host port publishing the Console container behind TLS termination; default 4173.
CONSOLE_PORT=4173
# [OPTIONAL] Host port publishing the Stage container behind TLS termination; default 4174.
STAGE_PORT=4174
# [OPTIONAL] Loopback host port for a private-backend TLS reverse proxy; default 3001.
PRIVATE_BACKEND_PUBLISH_PORT=3001
# [OPTIONAL] Loopback host port for a projection-gateway TLS reverse proxy; default 3002.
PROJECTION_GATEWAY_PUBLISH_PORT=3002
# [OPTIONAL] Image tag applied by the production Compose build; default latest.
IMAGE_TAG=latest

# [REQUIRED outside Compose] Exact HTTPS Console origin consumed directly by private-backend.
CONSOLE_ORIGIN=https://console.example.com
# [OPTIONAL] Private-backend listen address; default 0.0.0.0.
PRIVATE_BACKEND_HOST=0.0.0.0
# [OPTIONAL] Private-backend listen port; default 3001.
PRIVATE_BACKEND_PORT=3001
# [REQUIRED outside Compose] Exact internal projection-gateway origin used by private-backend.
PROJECTION_GATEWAY_ORIGIN=http://projection-gateway:3002
# [REQUIRED] PostgreSQL URL for durable private authority, account, and retrieval state.
PRIVATE_DATABASE_URL=postgresql://private_app:change-me-private-db-password@postgres:5432/impromptu_private
# [OPTIONAL] Durable coordinator state key; default default. Use one active writer per key.
PRIVATE_PREPARED_EVIDENCE_STATE_KEY=default
# [OPTIONAL] Per-account login burst capacity; default 5.
LOGIN_ACCOUNT_RATE_LIMIT_CAPACITY=5
# [OPTIONAL] Per-account login tokens refilled per second; default 0.1.
LOGIN_ACCOUNT_RATE_LIMIT_REFILL_PER_SECOND=0.1
# [OPTIONAL] Per-IP login burst capacity; default 20.
LOGIN_IP_RATE_LIMIT_CAPACITY=20
# [OPTIONAL] Per-IP login tokens refilled per second; default 1.
LOGIN_IP_RATE_LIMIT_REFILL_PER_SECOND=1
# [REQUIRED] Absolute temporary deck upload staging directory.
DECK_STAGING_ROOT=/var/lib/impromptu/staging
# [REQUIRED] Absolute rendered deck artifact directory shared by both Bun services.
DECK_ARTIFACT_ROOT=/var/lib/impromptu/decks
# [OPTIONAL] Absolute ingestion uv project path; defaults to services/ingestion relative to the backend.
INGESTION_PROJECT_PATH=/app/services/ingestion
# [OPTIONAL] Deck render deadline in positive integer milliseconds; default 60000.
DECK_RENDER_DEADLINE_MS=60000
# [OPTIONAL] Set exactly PASSED to enable supervised live publication; every other value blocks it.
LIVE_PUBLICATION_GATE_STATE=BLOCKED
# [OPTIONAL] Explicit LibreOffice executable used by ingestion rendering; otherwise platform discovery is used.
SOFFICE_PATH=/usr/bin/soffice
# [OPTIONAL, host-run development only] Local STT via the installed whisper.cpp toolchain;
# leave empty to keep /v1/audio routes closed. compose.production.yaml pins container paths
# instead — never point these host paths into Compose.
FFMPEG_BINARY_PATH=
# [OPTIONAL, host-run development only] Absolute pinned whisper.cpp CLI executable path.
WHISPER_CPP_BINARY_PATH=
# [OPTIONAL, host-run development only] Absolute pinned ggml-small-q5_1.bin model path.
WHISPER_CPP_MODEL_PATH=
# [REQUIRED, secret] OpenCode Go credential for the isolated chat slots.
CHAT_MODEL_API_KEY=change-me-opencode-go-api-key
# [REQUIRED] Credential-free HTTPS OpenCode Go base URL.
CHAT_MODEL_BASE_URL=https://opencode.ai/zen/go/v1
# [REQUIRED, secret] Credential for the isolated local embedding slot.
EMBEDDING_MODEL_API_KEY=local-embedding-token
# [REQUIRED] Credential-free HTTPS local embedding server base URL.
EMBEDDING_MODEL_BASE_URL=https://127.0.0.1:8443/v1
# [REQUIRED] Local 768-dimensional embedding model identifier (no free hosted alternative).
EMBEDDING_MODEL=embeddinggemma
# [LOCAL DEVELOPMENT ONLY] Trust the mkcert CA used by the local embedding TLS endpoint.
# Production deployments should use their platform trust store instead of this workstation path.
NODE_EXTRA_CA_CERTS=
# [REQUIRED] OpenCode Go rerank model identifier.
RERANK_MODEL=deepseek-v4.1-flash
# [OPTIONAL] Retry adapter for retryable provider failures; space-bunny-free is free.
RERANK_MODEL_FALLBACK=space-bunny-free
# [REQUIRED] OpenCode Go recommendation model identifier.
LLM_MODEL=deepseek-v4.1-flash
# [OPTIONAL] Retry adapter for retryable provider failures; space-bunny-free is free.
LLM_MODEL_FALLBACK=space-bunny-free
# [REQUIRED] OpenCode Go verifier model identifier.
VERIFIER_MODEL=deepseek-v4.1-flash
# [OPTIONAL] Retry adapter for retryable provider failures; space-bunny-free is free.
VERIFIER_MODEL_FALLBACK=space-bunny-free

# [OPTIONAL] Projection-gateway listen address; default 0.0.0.0.
PROJECTION_GATEWAY_HOST=0.0.0.0
# [OPTIONAL] Projection-gateway listen port; default 3002.
PROJECTION_GATEWAY_PORT=3002
# [REQUIRED] Exact HTTPS Stage browser origin consumed directly by projection-gateway.
STAGE_ORIGIN=https://stage.example.com
# [REQUIRED] Exact private-backend callback origin consumed by projection-gateway.
PRIVATE_BACKEND_ORIGIN=http://private-backend:3001
# [REQUIRED] PostgreSQL URL for durable public gateway state using the projection_app role.
PROJECTION_DATABASE_URL=postgresql://projection_app:change-me-projection-db-password@postgres:5432/impromptu_projection
# [OPTIONAL] Durable gateway state key; default default. Use one active writer per key.
PROJECTION_GATEWAY_STATE_KEY=default
# [OPTIONAL] Public HTTP burst capacity per IP; default 120.
PROJECTION_PUBLIC_RATE_LIMIT_CAPACITY=120
# [OPTIONAL] Public HTTP tokens refilled per IP per second; default 2.
PROJECTION_PUBLIC_RATE_LIMIT_REFILL_PER_SECOND=2
# [OPTIONAL] Realtime connection burst capacity per IP; default 20.
PROJECTION_CONNECTION_RATE_LIMIT_CAPACITY=20
# [OPTIONAL] Realtime connection tokens refilled per IP per second; default 1.
PROJECTION_CONNECTION_RATE_LIMIT_REFILL_PER_SECOND=1

# [OPTIONAL, build-time] Browser-visible Stage origin embedded in Console; development default is http://localhost:4174.
NEXT_PUBLIC_STAGE_ORIGIN=https://stage.example.com
# [OPTIONAL, build-time] Console service-worker release cohort; default stable.
NEXT_PUBLIC_SW_COHORT=stable
# [OPTIONAL, build-time] Set true only for explicitly approved co-resident Console mode; default false.
NEXT_PUBLIC_CO_RESIDENT_CONSOLE=false
# [OPTIONAL, build-time] Stage service-worker release cohort; default stable.
IMPROMPTU_RELEASE_COHORT=stable
# [OPTIONAL] Runtime mode read by Next and service-worker registration. Production images set
# NODE_ENV=production themselves; do NOT set it here or ambient bun test runs resolve React's
# production build and React.act disappears.

# [OPTIONAL, tests] Chrome/Chromium executable override for browser E2E and runtime verification.
CHROME_EXECUTABLE_PATH=
# [OPTIONAL, tests] Set true to run browser-runtime verification headed; default is headless.
BROWSER_HEADED=false
# [OPTIONAL, tests] Set true to retain browser-runtime artifacts after validation.
BROWSER_RUNTIME_RETAIN_ARTIFACTS=false
# [OPTIONAL, tests] Set true for prepared-evidence E2E debug logging.
DEBUG_WP3_E2E=false
# [OPTIONAL, tests] Set true for Windows-topology E2E debug logging.
DEBUG_WP4_E2E=false
# [OPTIONAL, tests] Set true for custom deck-upload E2E debug logging.
DEBUG_CUSTOM_DECK_E2E=false
# [OPTIONAL, tests] Windows-topology evidence output directory; default artifacts/wp4-topology.
WP4_EVIDENCE_DIR=artifacts/wp4-topology
# [OPTIONAL, tests] Console fixture port; default 44273.
TOPOLOGY_CONSOLE_PORT=44273
# [OPTIONAL, tests] Stage fixture port; default 44274.
TOPOLOGY_STAGE_PORT=44274
# [OPTIONAL, tests] Projection fixture port; default 44402.
TOPOLOGY_PROJECTION_PORT=44402
# [OPTIONAL, tests] Deterministic fast-check seed; default 20260814.
FAST_CHECK_SEED=20260814
# [OPTIONAL, tests] fast-check run count; default 250.
FAST_CHECK_RUNS=250
# [OPTIONAL, tests] Font file override used by custom deck generation/render verification.
IMPROMPTU_E2E_FONT_PATH=

# The following are inherited operating-system variables, not deployment settings.
# [OPTIONAL, OS] PATH is forwarded into isolated model-adapter processes and test subprocesses.
# [OPTIONAL, Windows OS] PATHEXT is forwarded into isolated model-adapter processes.
# [OPTIONAL, Windows OS] SystemRoot is forwarded into isolated model-adapter processes.
# [OPTIONAL, Windows OS] SYSTEMROOT is the uppercase SystemRoot variant forwarded to adapters.
# [OPTIONAL, OS] TEMP selects a temporary workspace root.
# [OPTIONAL, OS] TMP selects a temporary workspace root for isolated adapters.
# [OPTIONAL, OS] TMPDIR selects the E2E deck workspace root.
# [OPTIONAL, Windows OS] WINDIR is forwarded into isolated model-adapter processes.
# [OPTIONAL, OS] HOME is used to derive the default E2E font path.
# [OPTIONAL, Windows OS] PROGRAMFILES is searched for LibreOffice.
# [OPTIONAL, Windows OS] PROGRAMFILES(X86) is searched for 32-bit LibreOffice.
