{
  "browserRoots": ["apps/console", "apps/stage"],
  "forbiddenPackagePrefixes": [
    "@impromptu/model-router",
    "@anthropic-ai/sdk",
    "@azure/cognitiveservices-speech-sdk",
    "@aws-sdk/client-transcribe-streaming",
    "@deepgram/sdk",
    "@google/generative-ai",
    "@google/genai",
    "@huggingface/transformers",
    "@tensorflow/tfjs",
    "@xenova/transformers",
    "assemblyai",
    "onnxruntime-web",
    "openai"
  ],
  "forbiddenPathFragments": ["services/model-router"],
  "forbiddenArtifactExtensions": [
    ".bin",
    ".gguf",
    ".onnx",
    ".pt",
    ".pth",
    ".safetensors",
    ".tflite",
    ".wasm"
  ],
  "forbiddenContentSignatures": [
    "ANTHROPIC_API_KEY",
    "AZURE_SPEECH_KEY",
    "DEEPGRAM_API_KEY",
    "GOOGLE_GENERATIVE_AI_API_KEY",
    "OPENAI_API_KEY",
    "api.anthropic.com",
    "api.deepgram.com",
    "api.openai.com",
    "onnxruntime",
    "tokenizer.json"
  ],
  "forbiddenProviderOrigins": [
    "https://api.anthropic.com",
    "https://api.deepgram.com",
    "https://api.openai.com"
  ]
}
