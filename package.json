{
  "name": "impromptu-r2",
  "version": "0.0.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "check:repo": "bun run scripts/verify-repo.ts",
    "check:browser-boundary": "bun run scripts/check-browser-dependencies.ts",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run check:repo && bun run check:browser-boundary && bun run lint && bun run typecheck && bun run test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@types/bun": "1.2.20",
    "typescript": "5.9.2"
  }
}
