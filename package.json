{
  "name": "impromptu-r2",
  "version": "0.0.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "check:repo": "bun run scripts/verify-repo.ts",
    "check:boundaries": "bun run services/projection-gateway/test/check-architecture.ts",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:db": "bash tests/database/run.sh",
    "test:db:harness": "bash tests/database/harness-behavior.sh",
    "test:db:concurrent": "bash tests/database/concurrent-projects.sh",
    "check": "bun run check:repo && bun run check:boundaries && bun run lint && bun run typecheck && bun run test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@types/bun": "1.2.20",
    "typescript": "5.9.2"
  }
}
